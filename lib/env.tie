type tie<class>
// lib/env.tie：trm 库层③ 环境（命名空间 trm_env）。
// 读取环境变量（内置 get_env → @getenv 内联发射）+ 当前工作目录。
// 设定/遍历环境变量依赖平台桥，S1 先行读取面。
// 调用：import 后 trm_env.get("PATH") / trm_env.cwd()。
import "../stdlib/path.tie"

// trm.env 模块版本号（各模块独立版本化）。
const TRM_ENV_VERSION: string = "0.1.0"

namespace trm_env {
// ---------- 模块版本 ----------
pub func module_version() -> string {
    return TRM_ENV_VERSION
}

// ---------- 环境 ----------
pub func get(name: string) -> string {
    return get_env(name)
}

// 当前工作目录（std/path 包装）。
pub func cwd() -> string {
    return path.cwd()
}
}