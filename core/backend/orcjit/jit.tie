type tie<class>
// core/backend/orcjit/jit.tie —— orcjit LLVM JIT 后端（命名空间 trm_orcjit）。
// 对应 port/backend.tie 的 Backend 契约：与 interp/tiejit 同一 tieir、给出同契结果。
// 本后端把 tieir 纯函数的算术 op（与 core/middle/ir.tie 一致：add=0 sub=1 mul=2 div=3）
// 交给独立 LLVM-MCJIT 驱动进程 orcjit.exe（见本目录 orcjit.c / build-orcjit.ps1）真 JIT
// 执行，捕获 stdout 十进制结果后回灌，作为契约矩阵的第三个实端（真实 LLVM JIT 路径）。
// 说明：仅覆盖单块 2 参算术纯函数；完整 tieir→LLVM IR 降级留待 P3。
// 调用：trm_orcjit.run(fname, args) -> i64；失败返回 0 并置 j_err。
import "../../frontend/loader.tie"
import "../../../stdlib/process.tie"

// 驱动进程路径（本仓库内，独立 JIT 进程边界调用）。
const ORC_EXE: string = "f:\\Projects\\tie-repo\\trm\\core\\backend\\orcjit\\orcjit.exe"

var j_err: string = ""

namespace trm_orcjit {
pub func err_msg() -> string {
    return j_err
}

func find_func(fn: string) -> i64 {
    var n = trm_loader.func_count()
    var i: i64 = 0
    while i < n {
        if trm_loader.pool(trm_loader.func_name_id(i)) == fn {
            return i
        }
        i = i + 1
    }
    return -1
}

// 从函数入口块首个算术指令取 opcode（return 0=失败）。
func arith_op(fid: i64) -> i64 {
    var bid = trm_loader.func_entry(fid)
    var si = trm_loader.block_start(bid)
    var en = trm_loader.block_end(bid)
    while si < en {
        var o = trm_loader.ins_op(si)
        if o == 0 || o == 1 || o == 2 || o == 3 {
            return o
        }
        si = si + 1
    }
    return -1
}

// 解析驱动输出为整数：仅累加数字位（无 break / 无 ||，规避库 TU 后端怪癖），
// 前导负号；非数字字符直接忽略（驱动已无换行输出）。
func parse_int(s: string) -> i64 {
    var n = str_len(s)
    var i: i64 = 0
    var neg: bool = false
    if n > 0 && str_char(s, 0) == "-" {
        neg = true
    }
    var v: i64 = 0
    while i < n {
        var cc = char_code(str_char(s, i))
        if cc >= 48 && cc <= 57 {
            v = v * 10 + (cc - 48)
        }
        i = i + 1
    }
    if neg {
        v = -v
    }
    return v
}

// 执行纯函数：读 op → 调 LLVM JIT 驱动 → 捕获并解析结果。
pub func run(fname: string, args: table<i64>) -> i64 {
    j_err = ""
    var fid = find_func(fname)
    if fid < 0 {
        j_err = "函数未找到: " + fname
        return 0
    }
    var cnt = trm_loader.func_params_cnt(fid)
    if cnt != len(args) {
        j_err = "参数个数不符: " + fname
        return 0
    }
    if len(args) != 2 {
        j_err = "仅支持 2 参纯函数: " + fname
        return 0
    }
    var op = arith_op(fid)
    if op < 0 {
        j_err = "无可 JIT 算术指令: " + fname
        return 0
    }
    var cmd = ORC_EXE + " " + to_string(op) + " " + to_string(args[0]) + " " + to_string(args[1])
    var out = process.exec_output(cmd)
    if len(out) == 0 {
        j_err = "JIT 驱动无输出: " + cmd
        return 0
    }
    return parse_int(out)
}
}