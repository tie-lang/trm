type tie<tsh>
// build-orcjit.tsh.tie —— 构建 LLVM MCJIT 驱动 orcjit.exe（tsh 角色移植，替代 build-orcjit.ps1）
// ============================================================================
// 需 D:\LLVM（LLVM-C.dll/.lib + include/llvm-c）与 clang.exe；产出 orcjit.exe 并把
// LLVM-C.dll 复制到其旁。tsh 逐行求值（每物理行独立 eval，全局/函数跨行持久）；
// 外部命令经 exec_code（`cmd /c` 包裹并重定向，对齐 run.tsh.tie 规范）。**须在该
// 脚本所在目录运行**（tsh 无「脚本自身目录」内建，用 cwd() 定位）；LLVM 根可经环境
// 变量 TIE_LLVM_HOME 覆盖。默认 D:\LLVM 无空格，clang/-I 路径以未加引号形式传入 cmd。
// 注：tsh 行级 `exit <N>` 收字面量且不能置于 if 体内，无法按运行时结果退出非零；
// clang 缺失/构建失败打印错误并结束（成功路径退出码 0），为已知能力差异（对齐 run.tsh.tie）。

var root = cwd()
var llvm = get_env("TIE_LLVM_HOME")
if llvm == "" { llvm = "D:\\LLVM" }

var clang = path_join(path_join(llvm, "bin"), "clang.exe")
var has_clang = file_exists(clang) ? 1 : 0
if has_clang == 0 { println("[error] clang not found: " + clang) }

var src = path_join(root, "orcjit.c")
var outB = path_join(root, "orcjit.exe")
var inc = path_join(llvm, "include")
var lib = path_join(path_join(llvm, "lib"), "LLVM-C.lib")

// 构建（clang 缺失时不尝试；`cmd /c` + `>nul 2>&1` 吸收输出）
if has_clang != 0 { var rc = exec_code("cmd /c " + clang + " " + src + " -o " + outB + " -I" + inc + " " + lib + " -Wno-override-module >nul 2>&1") }

// 复制 LLVM-C.dll 到产物旁（静默，对齐原 Copy-Item）
var dllSrc = path_join(path_join(llvm, "bin"), "LLVM-C.dll")
var has_dll = file_exists(dllSrc) ? 1 : 0
if has_dll != 0 { var copy_rc = exec_code("cmd /c copy /Y " + dllSrc + " " + path_join(root, "LLVM-C.dll") + " >nul 2>&1") } else { println("[warning] LLVM-C.dll not found at " + dllSrc) }

println("built: " + outB)
exit 0