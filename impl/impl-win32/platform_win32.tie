type tie<class>
// impl/impl-win32/platform_win32.tie —— trm 平台桥（Win32，impl-win32）
// 命名空间 trm_platform；全部 pub unsafe（经 unsafe extern 桥原生 Win32/libc API）。
// 设计对应 docs/trm-final-design.md §6：平台实现层全 tie 写，unsafe extern + 桥原生。
//
// 能力：
//   - 终端：is_tty() / raw_mode(on)（Console 模式位）
//   - 进程管道：capture(cmd) —— 结构化 CreatePipe/CreateProcessW 捕获子进程 stdout；
//     write_cmd 写方向（_popen "w"）
//
// 结构化管道：repr(C) 窄字段（u32/i16）struct（STARTUPINFOW/PROCESS_INFORMATION）经
// addr_of 以 ptr 传给 Win32；SetHandleInformation 置写端可继承。此前受 tiec 窄字段
// struct store 未收窄缺陷阻塞（store 留下的值仍是 i64），后端修复（store 收窄 +
// datalayout 对齐，见 tie-main）后接入。
//
// 交付形态：tiec 本文件 --shared → trm_platform.dll（M5 动态库，C/外部宿主 LoadLibrary）；
// 库层 trm.terminal / trm.process 经 import 直接消费同一源码。

// ---------- 常量 ----------
const TP_STD_OUTPUT: i64 = -11   // STD_OUTPUT_HANDLE（is_tty 探测对象）
const TP_STD_INPUT: i64 = -10    // STD_INPUT_HANDLE（raw_mode 设置对象）
const TP_ENABLE_ECHO_INPUT: i64 = 4
const TP_ENABLE_LINE_INPUT: i64 = 2

// ---------- 全局状态（须在命名空间外定义） ----------
var tp_last_exit: i32 = 0   // 最近一次 run 的退出码（last_exit 查询；errno 式）

// ---------- 交互式进程会话状态（须在命名空间外定义；扁平 table<i64> 并行表，sid 即下标） ----------
var tp_s_hr: table<i64>;    // 会话 stdout 读端（父读子输出）
var tp_s_iw: table<i64>;    // 会话 stdin 写端（父写子输入；0 = 已关）
var tp_s_proc: table<i64>;  // 会话进程句柄
var tp_s_thr: table<i64>;   // 会话主线程句柄
var tp_s_act: table<i64>;   // 1 = 会话活跃

// ---------- repr(C) 结构化（CreateProcessW/CreatePipe 用；窄字段 pad 对齐由
//           tiec datalayout 保证，与 Win32 ABI 精确一致） ----------
// STARTUPINFOW（cb、dwX..dwFlags 等 u32 在 60 之前；lpReserved2 落 72、hStdInput 落 80，sizeof=104）
repr(C) struct TP_STARTUPINFOW {
    var cb: u32 = 0
    var lpReserved: i64 = 0
    var lpDesktop: i64 = 0
    var lpTitle: i64 = 0
    var dwX: u32 = 0
    var dwY: u32 = 0
    var dwXSize: u32 = 0
    var dwYSize: u32 = 0
    var dwXCountChars: u32 = 0
    var dwYCountChars: u32 = 0
    var dwFillAttribute: u32 = 0
    var dwFlags: u32 = 0
    var wShowWindow: u16 = 0
    var cbReserved2: u16 = 0
    var lpReserved2: i64 = 0
    var hStdInput: i64 = 0
    var hStdOutput: i64 = 0
    var hStdError: i64 = 0
}
// PROCESS_INFORMATION（sizeof=24）
repr(C) struct TP_PROCESS_INFORMATION {
    var hProcess: i64 = 0
    var hThread: i64 = 0
    var dwProcessId: u32 = 0
    var dwThreadId: u32 = 0
}

// ---------- Win32 / libc API（unsafe extern，标量/指针/string/repr(C) 形参） ----------
unsafe extern fn GetStdHandle(nStdHandle: i64) -> i64
unsafe extern fn GetConsoleMode(hConsole: i64, lpMode: ptr<i64>) -> i32
unsafe extern fn SetConsoleMode(hConsole: i64, dwMode: i64) -> i32
// 结构化进程管道（CreatePipe/CreateProcessW/ReadFile/句柄）
unsafe extern fn PeekNamedPipe(h: i64, buf: ptr<u8>, n: u32, pread: ptr<u32>, pavail: ptr<u32>, pmsg: i64) -> i32
unsafe extern fn CreatePipe(hr: ptr<i64>, hw: ptr<i64>, sa: i64, n: i32) -> i32
unsafe extern fn SetHandleInformation(h: i64, mask: u32, flags: u32) -> i32
unsafe extern fn CreateProcessW(app: i64, cmd: ptr<u8>, pa: i64, ta: i64, inh: i32, flags: i32, env: i64, cwd: i64, si: ptr<TP_STARTUPINFOW>, pi: ptr<TP_PROCESS_INFORMATION>) -> i32
unsafe extern fn ReadFile(h: i64, buf: ptr<u8>, n: u32, pread: ptr<u32>, ov: i64) -> i32
unsafe extern fn WriteFile(h: i64, buf: ptr<u8>, n: u32, pwritten: ptr<u32>, ov: i64) -> i32
unsafe extern fn GetExitCodeProcess(h: i64, pcode: ptr<u32>) -> i32
unsafe extern fn WaitForSingleObject(h: i64, ms: u32) -> u32
unsafe extern fn CloseHandle(h: i64) -> i32
unsafe extern fn GetLastError() -> u32
unsafe extern fn Sleep(ms: u32) -> i32
// libc 进程写管道（msvcrt _popen/_pclose/fwrite；FILE* 即 i64 句柄）
unsafe extern fn _popen(cmd: string, mode: string) -> i64
unsafe extern fn fwrite(buf: string, size: i64, count: i64, stream: i64) -> i64
unsafe extern fn _pclose(stream: i64) -> i64

namespace trm_platform {
// 输出句柄是否为真实控制台（重定向/管道返回 false）。
pub unsafe func is_tty() -> bool {
    var h = GetStdHandle(TP_STD_OUTPUT)
    if h == 0 || h == -1 {
        return false
    }
    var mode: i64 = 0
    var rc = GetConsoleMode(h, addr_of(mode))
    return rc != 0
}

// 开启/关闭输入控制台原始模式：on=true 关闭 ECHO+行缓冲（逐键读取）；
// on=false 恢复原模式。返回 true 表示成功（需真实控制台；重定向下静默 false）。
// 精确位清除：仅当 on 时按位减掉 ECHO/LINE 两项，其余位（含虚拟终端等）原样保留。
pub unsafe func raw_mode(on: bool) -> bool {
    var h = GetStdHandle(TP_STD_INPUT)
    if h == 0 || h == -1 {
        return false
    }
    var mode: i64 = 0
    if GetConsoleMode(h, addr_of(mode)) == 0 {
        return false   // 非控制台（重定向/管道）
    }
    var next: i64 = mode
    if on {
        if (mode & TP_ENABLE_ECHO_INPUT) != 0 {
            next = next - TP_ENABLE_ECHO_INPUT
        }
        if (mode & TP_ENABLE_LINE_INPUT) != 0 {
            next = next - TP_ENABLE_LINE_INPUT
        }
    }
    var ok = SetConsoleMode(h, next)
    return ok != 0
}

// ---------- 结构化进程管道（CreatePipe/CreateProcessW 捕获） ----------

// ASCII 字符串 → UTF-16LE 字节缓冲（逐码点写 u16 word 两个 u8 字节）。
// CreateProcessW 的 LPCWSTR 需 UTF-16，tie string 是 UTF-8 char*，须手拼。
unsafe fn tp_widewstr(s: string, out: ptr<u8>) {
    var n: i64 = str_len(s)
    var i: i64 = 0
    while i < n {
        var cp: i64 = char_code(str_char(s, i))   // ASCII 码点 = 字节值
        deref_write(ptr_add(out, 2 * i), as_u8(cp & 255))
        deref_write(ptr_add(out, 2 * i + 1), as_u8(0))
        i = i + 1
    }
    deref_write(ptr_add(out, 2 * n), as_u8(0))
    deref_write(ptr_add(out, 2 * n + 1), as_u8(0))
}

// 捕获命令输出：结构化 CreatePipe/CreateProcessW（STARTUPINFOW/PROCESS_INFORMATION
// 经 addr_of 以 ptr 传 Win32，SetHandleInformation 置写端可继承），父进程读子进程
// stdout 到最后一块（子进程独占写端、退出即 EOF）。失败/空输出返回 ""；上限 8MB 防异常不返回。
pub unsafe func capture(cmd: string) -> string {
    var hr: i64 = 0
    var hw: i64 = 0
    var si: TP_STARTUPINFOW = TP_STARTUPINFOW()
    var pi: TP_PROCESS_INFORMATION = TP_PROCESS_INFORMATION()
    var rcount: u32 = 0
    var buf: ptr<u8> = alloc(4096)
    if CreatePipe(addr_of(hr), addr_of(hw), 0, 0) == 0 {
        return ""
    }
    // 写端置可继承（子进程继承写端）；读端清继承位 → 子进程退出后 EOF
    SetHandleInformation(hw, 1u32, 1u32)
    SetHandleInformation(hr, 1u32, 0u32)
    // 结构化 STARTUPINFOW：cb=sizeof(104)，附加 std 句柄到管道写端
    si.cb = as_u32(104)
    si.dwFlags = as_u32(256)          // STARTF_USESTDHANDLES = 0x100
    si.hStdInput = GetStdHandle(-10)  // STD_INPUT_HANDLE（子进程不读 stdin）
    si.hStdOutput = hw
    si.hStdError = hw
    // 手拼 UTF-16 命令行（含文件名（全模式名））
    var wcmd: ptr<u8> = alloc((str_len(cmd) + 1) * 2)
    tp_widewstr(cmd, wcmd)
    if CreateProcessW(0, wcmd, 0, 0, 1i32, 0i32, 0, 0, addr_of(si), addr_of(pi)) == 0 {
        return ""
    }
    // 父进程关闭写端 → 子进程独占写端，退出即 EOF
    CloseHandle(hw)
    var out: string = ""
    var guard: i64 = 0
    while guard < 8388608 {   // 上限 8MB，防异常不返回
        rcount = as_u32(0)
        if ReadFile(hr, buf, 4096u32, addr_of(rcount), 0) == 0 {
            break
        }
        var j: i64 = 0
        while j < as_i64(rcount) {
            out = out + str_from_code(as_i64(deref(ptr_add(buf, j))))
            j = j + 1
        }
        if rcount == 0u32 {
            break
        }
        guard = guard + 1
    }
    CloseHandle(hr)
    WaitForSingleObject(pi.hProcess, 0xFFFFFFFFu32)
    CloseHandle(pi.hProcess)
    CloseHandle(pi.hThread)
    return out
}

// ASCII 字符串 → 单字节缓冲（逐码点写低 8 位；供 WriteFile 写子进程 stdin）。
unsafe fn tp_ascii_buf(s: string, out: ptr<u8>) {
    var n: i64 = str_len(s)
    var i: i64 = 0
    while i < n {
        deref_write(ptr_add(out, i), as_u8(char_code(str_char(s, i)) & 255))
        i = i + 1
    }
    deref_write(ptr_add(out, n), as_u8(0))
}

// 双向管道：启动子进程，把 input 写入其 stdin（关闭即 EOF），读其 stdout 到 EOF，
// 返回子进程 stdout 全部内容（ASCII 精确）；退出码经 last_exit() 查询（errno 式）。
// 与 capture 同用 CreatePipe/CreateProcessW 结构化路径，但建**两个**管道：
//   pipeOut（子进程 stdout→父读）、pipeIn（父写→子进程 stdin）；
// 适用于"先喂完输入再读输出"的批处理式子进程（如 set /p 读取一行）。失败返回 ""。
pub unsafe func run(cmd: string, input: string) -> string {
    var hr: i64 = 0   // pipeOut 读端（父读子 stdout）
    var hw: i64 = 0   // pipeOut 写端（子进程 stdout）
    var ir: i64 = 0   // pipeIn 读端（子进程 stdin）
    var iw: i64 = 0   // pipeIn 写端（父写子 stdin）
    var si: TP_STARTUPINFOW = TP_STARTUPINFOW()
    var pi: TP_PROCESS_INFORMATION = TP_PROCESS_INFORMATION()
    var rcount: u32 = 0
    var buf: ptr<u8> = alloc(4096)
    tp_last_exit = as_i32(0)
    if CreatePipe(addr_of(hr), addr_of(hw), 0, 0) == 0 {
        return ""
    }
    if CreatePipe(addr_of(ir), addr_of(iw), 0, 0) == 0 {
        CloseHandle(hr)
        CloseHandle(hw)
        return ""
    }
    // 子进程侧句柄置可继承；父进程侧清继承位
    SetHandleInformation(hw, 1u32, 1u32)
    SetHandleInformation(ir, 1u32, 1u32)
    SetHandleInformation(hr, 1u32, 0u32)
    SetHandleInformation(iw, 1u32, 0u32)
    // 结构化 STARTUPINFOW：stdin/out/err 三句柄接管道
    si.cb = as_u32(104)
    si.dwFlags = as_u32(256)          // STARTF_USESTDHANDLES = 0x100
    si.hStdInput = ir
    si.hStdOutput = hw
    si.hStdError = hw
    var wcmd: ptr<u8> = alloc((str_len(cmd) + 1) * 2)
    tp_widewstr(cmd, wcmd)
    if CreateProcessW(0, wcmd, 0, 0, 1i32, 0i32, 0, 0, addr_of(si), addr_of(pi)) == 0 {
        CloseHandle(hr)
        CloseHandle(hw)
        CloseHandle(ir)
        CloseHandle(iw)
        return ""
    }
    // 父进程释放子进程侧句柄副本（子进程已继承）
    CloseHandle(hw)
    CloseHandle(ir)
    // 写 input 到子进程 stdin，写完关闭写端 → 子进程读到 EOF
    var n: i64 = str_len(input)
    if n > 0 {
        var ibuf: ptr<u8> = alloc(n + 1)
        tp_ascii_buf(input, ibuf)
        var written: u32 = 0
        WriteFile(iw, ibuf, as_u32(n), addr_of(written), 0)
    }
    CloseHandle(iw)
    // 读子进程 stdout 到最后一块（子进程独占写端、退出即 EOF）
    var out: string = ""
    var guard: i64 = 0
    while guard < 8388608 {   // 上限 8MB，防异常不返回
        rcount = as_u32(0)
        if ReadFile(hr, buf, 4096u32, addr_of(rcount), 0) == 0 {
            break
        }
        var j: i64 = 0
        while j < as_i64(rcount) {
            out = out + str_from_code(as_i64(deref(ptr_add(buf, j))))
            j = j + 1
        }
        if rcount == 0u32 {
            break
        }
        guard = guard + 1
    }
    CloseHandle(hr)
    WaitForSingleObject(pi.hProcess, 0xFFFFFFFFu32)
    var ec: u32 = 0
    if GetExitCodeProcess(pi.hProcess, addr_of(ec)) != 0 {
        tp_last_exit = as_i32(ec)
    }
    CloseHandle(pi.hProcess)
    CloseHandle(pi.hThread)
    return out
}

// 最近一次 run 的退出码（0 = 成功或尚未 run；errno 式，供 dll 边界下查询）。
pub unsafe func last_exit() -> i32 {
    return tp_last_exit
}

// 让出当前线程 ms 毫秒（Win32 Sleep；供实时轮询循环让子进程获得调度时间片）。
pub unsafe func msleep(ms: i64) {
    if ms <= 0 {
        return
    }
    Sleep(as_u32(ms))
}

// ---------- 交互式进程会话（S10d） ----------
// 与 run 的批处理式（写完全部 input 即关 stdin EOF，再读 stdout 到 EOF）不同：
// 会话启动后**保留 stdin 写端**（子进程不见 EOF），调用方按需实时 write/read 多轮，
// 直到主动 run_close_in（子进程读到 EOF）收尾。会话句柄与活跃位见文件头 tp_s_* 并行表
// （扁平规避嵌套表复绑定缺陷）；句柄回收与幂等清理由 run_wait 兜底。

// 启动交互式子进程：建两条管道（pipeOut 子 stdout→父读、pipeIn 父写→子 stdin），
// CreateProcessW 启动后**父进程保留 stdin 写端**（run 会在写完后关闭）。返回会话 id；
// 失败返回 -1。句柄按 id 存入并行表，供 write/read/avail/close_in/wait/free 使用。
pub unsafe func spawn_run(cmd: string) -> i64 {
    var id: i64 = len(tp_s_hr)
    table_push(tp_s_hr, 0)
    table_push(tp_s_iw, 0)
    table_push(tp_s_proc, 0)
    table_push(tp_s_thr, 0)
    table_push(tp_s_act, 0)
    var hr: i64 = 0
    var hw: i64 = 0
    var ir: i64 = 0
    var iw: i64 = 0
    var si: TP_STARTUPINFOW = TP_STARTUPINFOW()
    var pi: TP_PROCESS_INFORMATION = TP_PROCESS_INFORMATION()
    if CreatePipe(addr_of(hr), addr_of(hw), 0, 0) == 0 {
        return -1
    }
    if CreatePipe(addr_of(ir), addr_of(iw), 0, 0) == 0 {
        CloseHandle(hr)
        CloseHandle(hw)
        return -1
    }
    // 子进程侧句柄置可继承；父进程侧清继承位
    SetHandleInformation(hw, 1u32, 1u32)
    SetHandleInformation(ir, 1u32, 1u32)
    SetHandleInformation(hr, 1u32, 0u32)
    SetHandleInformation(iw, 1u32, 0u32)
    // 结构化 STARTUPINFOW：stdin/out/err 三句柄接管道
    si.cb = as_u32(104)
    si.dwFlags = as_u32(256)          // STARTF_USESTDHANDLES = 0x100
    si.hStdInput = ir
    si.hStdOutput = hw
    si.hStdError = hw
    var wcmd: ptr<u8> = alloc((str_len(cmd) + 1) * 2)
    tp_widewstr(cmd, wcmd)
    if CreateProcessW(0, wcmd, 0, 0, 1i32, 0i32, 0, 0, addr_of(si), addr_of(pi)) == 0 {
        CloseHandle(hr)
        CloseHandle(hw)
        CloseHandle(ir)
        CloseHandle(iw)
        return -1
    }
    // 父进程释放子进程侧句柄副本（子进程已继承）；**保留 stdin 写端**（交互态）
    CloseHandle(hw)
    CloseHandle(ir)
    tp_s_hr[id] = hr
    tp_s_iw[id] = iw
    tp_s_proc[id] = pi.hProcess
    tp_s_thr[id] = pi.hThread
    tp_s_act[id] = 1
    return id
}

// 向会话 stdin 写数据（不关闭写入端）。返回实际写入字节数；失败/会话无效返回 -1。
pub unsafe func run_write(sid: i64, data: string) -> i32 {
    if sid < 0 || sid >= len(tp_s_iw) || tp_s_act[sid] == 0 {
        return -1
    }
    var n: i64 = str_len(data)
    if n == 0 {
        return 0
    }
    var ibuf: ptr<u8> = alloc(n + 1)
    tp_ascii_buf(data, ibuf)
    var written: u32 = 0
    if WriteFile(tp_s_iw[sid], ibuf, as_u32(n), addr_of(written), 0) == 0 {
        return 0
    }
    return as_i32(written)
}

// 非阻塞探测会话 stdout 当前可读字节数（PeekNamedPipe）；-1 = 会话无效/断管。
pub unsafe func run_avail(sid: i64) -> i64 {
    if sid < 0 || sid >= len(tp_s_hr) || tp_s_act[sid] == 0 {
        return -1
    }
    var nb: ptr<u8> = alloc(1)   // 真实探针缓冲（NULL 缓冲 PeekNamedPipe 会失败）
    var got: u32 = 0
    var total: u32 = 0
    if PeekNamedPipe(tp_s_hr[sid], nb, 1u32, addr_of(got), addr_of(total), 0) == 0 {
        return -1
    }
    return as_i64(total)
}

// 阻塞读会话 stdout 一帧（至多 4096 字节；子进程退出即 EOF 返回空串）。
// 用于实时对话：先 read 等应答，再 write 下一轮输入。
pub unsafe func run_read(sid: i64) -> string {
    if sid < 0 || sid >= len(tp_s_hr) || tp_s_act[sid] == 0 {
        return ""
    }
    var rcount: u32 = 0
    var buf: ptr<u8> = alloc(4096)
    if ReadFile(tp_s_hr[sid], buf, 4096u32, addr_of(rcount), 0) == 0 {
        return ""   // EOF（子进程退出/断管）
    }
    var out: string = ""
    var j: i64 = 0
    while j < as_i64(rcount) {
        out = out + str_from_code(as_i64(deref(ptr_add(buf, j))))
        j = j + 1
    }
    return out
}

// 关闭会话 stdin 写端 → 子进程读到 EOF（收尾阶段：子进程排空输出后退出）。
pub unsafe func run_close_in(sid: i64) -> i32 {
    if sid < 0 || sid >= len(tp_s_iw) || tp_s_act[sid] == 0 {
        return -1
    }
    if tp_s_iw[sid] != 0 {
        CloseHandle(tp_s_iw[sid])
        tp_s_iw[sid] = 0
    }
    return 1
}

// 等待会话进程退出并返回退出码；同时回收进程句柄与会话状态（幂等，可重复调用）。
pub unsafe func run_wait(sid: i64) -> i32 {
    if sid < 0 || sid >= len(tp_s_proc) || tp_s_act[sid] == 0 {
        return -1
    }
    WaitForSingleObject(tp_s_proc[sid], 0xFFFFFFFFu32)
    var ec: u32 = 0
    if GetExitCodeProcess(tp_s_proc[sid], addr_of(ec)) != 0 {
        tp_last_exit = as_i32(ec)
    }
    CloseHandle(tp_s_proc[sid])
    CloseHandle(tp_s_thr[sid])
    CloseHandle(tp_s_hr[sid])
    if tp_s_iw[sid] != 0 {
        CloseHandle(tp_s_iw[sid])
        tp_s_iw[sid] = 0
    }
    tp_s_proc[sid] = 0
    tp_s_thr[sid] = 0
    tp_s_hr[sid] = 0
    tp_s_act[sid] = 0
    return tp_last_exit
}

// 以写方向打开子进程管道（`_popen(cmd,"w")`），把 data 全部写入其 stdin。
// 返回写入字节数；失败返回 -1。
pub unsafe func write_cmd(cmd: string, data: string) -> i64 {
    var fp = _popen(cmd, "w")
    if fp == 0 {
        return -1
    }
    var nw = fwrite(data, 1, len(data), fp)
    _pclose(fp)
    return nw
}
}