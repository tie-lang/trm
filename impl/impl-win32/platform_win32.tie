type tie<class>
// impl/impl-win32/platform_win32.tie —— trm 平台桥（Win32，impl-win32）
// 命名空间 trm_platform；全部 pub unsafe（经 unsafe extern 桥原生 Win32/libc API）。
// 设计对应 docs/trm-final-design.md §6：平台实现层全 tie 写，unsafe extern + 桥原生。
//
// 能力：
//   - 终端：is_tty() / raw_mode(on)（Console 模式位）
//   - 进程管道：capture(cmd) —— _popen 捕获子进程 stdout；write_cmd 写方向
//
// 说明：CreatePipe/CreateProcessW 的 STARTUPINFOW/SECURITY_ATTRIBUTES/PROCESS_INFORMATION
// 需 repr(C) 窄字段（u32/i16）struct 精确布局经指针传递，而当前 tiec 对窄字段 struct 的
// store 存在 codegen 缺陷（值未收窄到 i32）——留待后端修复后接入结构化管道，见 README。
//
// 交付形态：tiec 本文件 --shared → trm_platform.dll（M5 动态库，C/外部宿主 LoadLibrary）；
// 库层 trm.terminal / trm.process 经 import 直接消费同一源码。

// ---------- 常量 ----------
const TP_STD_OUTPUT: i64 = -11   // STD_OUTPUT_HANDLE（is_tty 探测对象）
const TP_STD_INPUT: i64 = -10    // STD_INPUT_HANDLE（raw_mode 设置对象）
const TP_ENABLE_ECHO_INPUT: i64 = 4
const TP_ENABLE_LINE_INPUT: i64 = 2
const TP_EOF: i64 = -1           // fgetc 文件尾

// ---------- Win32 / libc API（unsafe extern，仅标量/指针/string 形参） ----------
unsafe extern fn GetStdHandle(nStdHandle: i64) -> i64
unsafe extern fn GetConsoleMode(hConsole: i64, lpMode: ptr<i64>) -> i32
unsafe extern fn SetConsoleMode(hConsole: i64, dwMode: i64) -> i32
// libc 进程管道（msvcrt _popen/_pclose/fgetc/fwrite；FILE* 即 i64 句柄，无结构体 ABI）
unsafe extern fn _popen(cmd: string, mode: string) -> i64
unsafe extern fn fgetc(stream: i64) -> i32
unsafe extern fn fwrite(buf: string, size: i64, count: i64, stream: i64) -> i64
unsafe extern fn _pclose(stream: i64) -> i64

namespace trm_platform {
// 输出句柄是否为真实控制台（重定向/管道返回 false）。
pub unsafe func is_tty() -> bool {
    var h = GetStdHandle(TP_STD_OUTPUT)
    if h == 0 || h == -1 {
        return false
    }
    var mode: i64 = 0
    var rc = GetConsoleMode(h, addr_of(mode))
    return rc != 0
}

// 开启/关闭输入控制台原始模式：on=true 关闭 ECHO+行缓冲（逐键读取）；
// on=false 恢复原模式。返回 true 表示成功（需真实控制台；重定向下静默 false）。
// 精确位清除：仅当 on 时按位减掉 ECHO/LINE 两项，其余位（含虚拟终端等）原样保留。
pub unsafe func raw_mode(on: bool) -> bool {
    var h = GetStdHandle(TP_STD_INPUT)
    if h == 0 || h == -1 {
        return false
    }
    var mode: i64 = 0
    if GetConsoleMode(h, addr_of(mode)) == 0 {
        return false   // 非控制台（重定向/管道）
    }
    var next: i64 = mode
    if on {
        if (mode & TP_ENABLE_ECHO_INPUT) != 0 {
            next = next - TP_ENABLE_ECHO_INPUT
        }
        if (mode & TP_ENABLE_LINE_INPUT) != 0 {
            next = next - TP_ENABLE_LINE_INPUT
        }
    }
    var ok = SetConsoleMode(h, next)
    return ok != 0
}

// ---------- 进程管道（_popen 捕获） ----------
// 捕获命令输出：`_popen(cmd,"r")` 建管道读子进程 stdout 字节流，fgetc 逐字节读到 EOF，
// 返回全部输出内容（ASCII 精确；UTF-8 多字节逐字节近似）。失败/空输出返回 ""。
pub unsafe func capture(cmd: string) -> string {
    var fp = _popen(cmd, "r")
    if fp == 0 {
        return ""
    }
    var out: string = ""
    var guard: i64 = 0
    while guard < 8388608 {   // 上限 8MB，防异常不返回
        var c = fgetc(fp)
        if as_i64(c) == TP_EOF {
            break
        }
        out = out + str_from_code(as_i64(c))
        guard = guard + 1
    }
    _pclose(fp)
    return out
}

// 以写方向打开子进程管道（`_popen(cmd,"w")`），把 data 全部写入其 stdin。
// 返回写入字节数；失败返回 -1。
pub unsafe func write_cmd(cmd: string, data: string) -> i64 {
    var fp = _popen(cmd, "w")
    if fp == 0 {
        return -1
    }
    var nw = fwrite(data, 1, len(data), fp)
    _pclose(fp)
    return nw
}
}