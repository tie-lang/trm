type tie<logic>
// main.tie：trm 库层基础功能回归/demo。
// 依次调用 fs/process/env/clock/terminal 各模块，验证编译零错误 + 运行结果。

// 平台桥（impl-win32）经 terminal 的库内转接接入（trm_terminal.is_tty）；
// terminal 的传递导入已使平台层随 main 汇总自动展开（深层/多导入展开序限制修复后）。

import "./lib/fs.tie"
import "./lib/process.tie"
import "./lib/env.tie"
import "./lib/clock.tie"
import "./lib/terminal.tie"
import "./lib/session.tie"
import "./lib/data.tie"
import "./lib/net.tie"
import "./impl/impl-win32/platform_win32.tie"

// trm 整体发行版本号（主/次/补丁；各模块版本独立见各 lib/x.tie 的 module_version）。
const TRM_VERSION: string = "0.1.0"

func main() {
    trm_terminal.info("trm 库层基础功能回归")
    trm_terminal.info("trm 发行版本 = " + TRM_VERSION
        + "  |  fs=" + trm_fs.module_version()
        + "  process=" + trm_process.module_version()
        + "  env=" + trm_env.module_version()
        + "  clock=" + trm_clock.module_version()
        + "  terminal=" + trm_terminal.module_version()
        + "  session=" + trm_session.module_version()
        + "  data=" + trm_data.module_version()
        + "  net=" + trm_net.module_version())

    // --- fs：写 → 读 → 删 ---
    var p = ".trm_demo.txt"
    var wrote = trm_fs.write(p, "hello trm")
    var back = trm_fs.read_text(p)
    trm_terminal.info("fs.write=" + fmt_bool(wrote) + "  read=" + back)
    var removed = trm_fs.remove_file(p)
    trm_terminal.info("fs.remove_file=" + fmt_bool(removed) + "  exists=" + fmt_bool(trm_fs.exists(p)))

    // --- process：退出码 + 捕获输出 ---
    var exit_code = trm_process.exec("echo hi > NUL")
    var out = trm_process.output("echo trm-out")
    trm_terminal.info("process.code=" + to_string(exit_code) + "  out=" + out)

    // --- process：平台桥管道捕获（_popen，非交互可验证） ---
    unsafe {
        var pout = trm_process.capture("cmd /c echo hello")
        trm_terminal.info("process.capture=[ " + pout + "]（坠入 hello 即管道通车）")
    }

    // --- env：环境变量 + 工作目录 ---
    var cwd = trm_env.cwd()
    var plen: i64 = len(trm_env.get("PATH"))
    trm_terminal.info("env.cwd=" + cwd + "  PATH_len=" + to_string(plen))

    // --- clock：时间戳与延时 ---
    var t0 = trm_clock.now_ms()
    trm_clock.delay_ms(1)
    var dt = trm_clock.now_ms() - t0
    trm_terminal.info("clock.now=" + to_string(trm_clock.now()) + "  elapsed_ms=" + to_string(dt))

    // --- session：config/profile/history 基础 ---
    var sess_ok = trm_session.ensure_config()
    trm_terminal.info("session.config_dir=" + trm_session.config_dir() + "  ensure=" + fmt_bool(sess_ok))
    var set_ok = trm_session.profile_set("demo_key", "42")
    var get_v = trm_session.profile_get("demo_key")
    trm_terminal.info("session.profile_set=" + fmt_bool(set_ok) + "  get(demo_key)=" + get_v)
    var hist_ok = trm_session.history_append("cmd-" + to_string(trm_clock.now()))
    trm_terminal.info("session.history_append=" + fmt_bool(hist_ok) + "  history_len=" + to_string(len(trm_session.history_read())))

    // --- data：写 → 读字节 → 读文本 → 删 ---
    var fi = ".trm_data_demo.bin"
    var dw = trm_data.write(fi, "trm-data")
    var dbytes = trm_data.read_bytes(fi)
    var dtxt = trm_data.read_text(fi)
    trm_terminal.info("data.write=" + fmt_bool(dw) + "  bytes=" + to_string(len(dbytes)) + "  text=" + dtxt + "  size=" + to_string(trm_data.size(fi)))
    trm_data.remove(fi)
    trm_terminal.info("data.remove_exists=" + fmt_bool(trm_data.exists(fi)))

    // --- net：模块可用性（版本+链接通过）；socket e2e 需并发，S3 M:N 再做 ---
    trm_terminal.info("net.module_ok（编译+链接已通过；socket e2e 延后至 S3）")

    // --- terminal：日志辅助 + 平台桥 TTY 探测 ---
    unsafe {
        var tty = trm_terminal.is_tty()
        trm_terminal.info("terminal.is_tty=" + fmt_bool(tty))
    }
    trm_terminal.ok("库层基础功能回归通过")
}

// bool → "true"/"false"（to_string 对 bool 的显示不可靠，单独格式化）。
func fmt_bool(b: bool) -> string {
    if b {
        return "true"
    }
    return "false"
}